VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard

# Put your provider's WireGuard config at ./wireguard/wg0.conf.
# Gluetun extracts the keys, endpoint, and addresses from that file.

# Lightweight local HTTP proxy exposed on localhost:8888.
HTTPPROXY=on
HTTPPROXY_LISTENING_ADDRESS=:8888

# Keep DNS inside the VPN container.
DOT=on
BLOCK_MALICIOUS=on
BLOCK_SURVEILLANCE=off
BLOCK_ADS=off
